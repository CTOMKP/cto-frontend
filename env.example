# Privy API Configuration
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here

# Server Configuration
PORT=3001

# Frontend Environment Variables (for .env.local)
NEXT_PUBLIC_BACKEND_URL=https://cto-backend-production-28e3.up.railway.app

# Change only this value to switch the frontend between the configured profiles.
# Use devnet for testing and mainnet-beta for real USDC payments.
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com










